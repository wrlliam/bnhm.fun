# Copy to .env and adjust. All values are optional.

# Host port the app is published on (docker compose) — default 3000
PORT=3000

# Interface the app's port is published on. Use 127.0.0.1 when your own
# reverse proxy (e.g. Caddy) runs on the same machine, so the app isn't
# reachable directly. Default: 0.0.0.0 (all interfaces)
# BIND=127.0.0.1

# Dev server only: extra hostnames/IPs allowed to load the dev server,
# e.g. your computer's LAN IP when running `bun dev` inside Docker.
# ALLOWED_DEV_ORIGINS=192.168.1.20,my-laptop.local

# Public URL, used for share previews (Open Graph). Default https://bnhm.fun
# NEXT_PUBLIC_SITE_URL=https://bnhm.fun

# Redis for persistent rooms. docker compose runs one for you by default.
# Set to empty (REDIS_URL=) to keep rooms in memory only; for `bun dev`, e.g.
# REDIS_URL=redis://localhost:6379

# Owner-only usage dashboard at /stats (privacy-friendly counters). Unset = off.
# STATS_KEY=choose-a-long-random-string
