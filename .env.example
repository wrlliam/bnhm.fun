# Copy to .env and adjust. All values are optional.

# Host port the app is published on (docker compose) — default 3000
PORT=3000

# Reverse proxy (docker compose --profile proxy):
#   a real domain pointed at this server → automatic HTTPS
#   leave unset → plain HTTP on port 80
# DOMAIN=games.example.com

# Dev server only: extra hostnames/IPs allowed to load the dev server,
# e.g. your computer's LAN IP when running `bun dev` inside Docker.
# ALLOWED_DEV_ORIGINS=192.168.1.20,my-laptop.local

# Public URL, used for share previews (Open Graph). Default https://bnhm.fun
# NEXT_PUBLIC_SITE_URL=https://bnhm.fun
