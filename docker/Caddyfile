# Reverse proxy in front of the app. Set DOMAIN in .env:
#   DOMAIN=games.example.com  → automatic HTTPS (Let's Encrypt)
#   DOMAIN=:80 (default)      → plain HTTP on port 80
{$DOMAIN::80} {
	encode zstd gzip

	# Live updates use Server-Sent Events: never buffer or compress them.
	@stream path /api/rooms/*/stream
	handle @stream {
		reverse_proxy app:3000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy app:3000
	}
}
