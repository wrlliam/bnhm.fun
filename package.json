{
  "name": "bnhm-fun",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "docker:up": "docker compose up -d --build",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:logs": "docker compose logs -f app",
    "docker:down": "docker compose --profile tunnel down",
    "docker:tunnel": "docker compose --profile tunnel up -d --build && sleep 6 && docker compose logs tunnel | grep -o 'https://[a-z0-9-]*\\.trycloudflare\\.com' | tail -1",
    "icons": "bun scripts/generate-icons.ts"
  },
  "dependencies": {
    "next": "16.4.4",
    "qrcode": "^1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.3",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "description": "Party games for everyone's phone: Ring of Fire, Most Likely To, Hangman and more."
}
